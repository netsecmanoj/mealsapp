generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  SUPERVISOR
  ADMIN
  HR_ADMIN
  SUPER_ADMIN
  GROUND_STAFF
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

enum MealRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum Source {
  SELF
  SUPERVISOR
  ADMIN
}

model User {
  id             String       @id @default(cuid())
  employeeId     String       @unique
  name           String
  email          String?      @unique
  passwordHash   String?
  phone          String?
  authProvider   String?
  dept           String?
  site           String?
  role           Role
  pinHash        String
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  mealChoices    MealChoice[] @relation("MealChoiceUser")
  updatedChoices MealChoice[] @relation("MealChoiceUpdatedBy")
  serviceDays    ServiceDay[] @relation("ServiceDayUpdatedBy")
  supervisorLink SupervisorAssignment? @relation("EmployeeAssignment")
  superviseeLinks SupervisorAssignment[] @relation("SupervisorAssignment")
  mealPreferences MealPreference[]
  updatedPreferences MealPreference[] @relation("MealPreferenceUpdatedBy")
  mealCheckins MealCheckin[]
  recordedCheckins MealCheckin[] @relation("MealCheckinRecordedBy")
  auditLogs AuditLog[] @relation("AuditActor")
  appSettings AppSetting[] @relation("AppSettingUpdatedBy")
  mealRequests MealRequest[]
  decidedMealRequests MealRequest[] @relation("MealRequestDecidedBy")
  createdVisitors Visitor[] @relation("VisitorCreatedBy")
  visitorMealChoices VisitorMealChoice[] @relation("VisitorMealCreatedBy")
  createdInvites UserInvite[] @relation("UserInviteCreatedBy")
}

model MealChoice {
  id          String   @id @default(cuid())
  date        DateTime
  mealType    MealType
  wantMeal    Boolean
  source      Source
  updatedAt   DateTime @updatedAt
  userId      String
  updatedById String?
  user        User     @relation("MealChoiceUser", fields: [userId], references: [id])
  updatedBy   User?    @relation("MealChoiceUpdatedBy", fields: [updatedById], references: [id])

  @@unique([userId, date, mealType])
  @@index([date, mealType])
}

model ServiceDay {
  date             String   @id
  isOfficeOpen     Boolean  @default(true)
  breakfastServed  Boolean  @default(true)
  lunchServed      Boolean  @default(true)
  dinnerServed     Boolean  @default(true)
  breakfastCutoff  String?
  lunchCutoff      String?
  dinnerCutoff     String?
  note             String?
  updatedAt        DateTime @updatedAt
  updatedById      String?
  updatedBy        User?    @relation("ServiceDayUpdatedBy", fields: [updatedById], references: [id])
}

model SupervisorAssignment {
  id           String   @id @default(cuid())
  employeeId   String   @unique
  supervisorId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee     User     @relation("EmployeeAssignment", fields: [employeeId], references: [id])
  supervisor   User     @relation("SupervisorAssignment", fields: [supervisorId], references: [id])

  @@index([supervisorId])
}

model MealPreference {
  id              String   @id @default(cuid())
  userId          String
  mealType        MealType
  defaultWantMeal Boolean
  daysMask        Int      @default(127)
  startDate       String?
  endDate         String?
  active          Boolean  @default(true)
  updatedAt       DateTime @updatedAt
  updatedById     String?

  user        User  @relation(fields: [userId], references: [id])
  updatedBy   User? @relation("MealPreferenceUpdatedBy", fields: [updatedById], references: [id])

  @@index([userId, mealType])
}

model MealCheckin {
  id           String   @id @default(cuid())
  date         String
  mealType     MealType
  userId       String
  takenAt      DateTime @default(now())
  recordedById String?
  note         String?

  user        User  @relation(fields: [userId], references: [id])
  recordedBy  User? @relation("MealCheckinRecordedBy", fields: [recordedById], references: [id])

  @@unique([userId, date, mealType])
  @@index([date, mealType])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  reason    String?
  before    String?
  after     String?
  createdAt DateTime @default(now())

  actor     User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([actorId])
}

model AppSetting {
  key         String   @id
  value       String
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("AppSettingUpdatedBy", fields: [updatedById], references: [id])
}

model MealRequest {
  id             String            @id @default(cuid())
  userId         String
  date           String
  mealType       MealType
  status         MealRequestStatus @default(PENDING)
  note           String?
  decidedById    String?
  decidedAt      DateTime?
  decisionReason String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user      User  @relation(fields: [userId], references: [id])
  decidedBy User? @relation("MealRequestDecidedBy", fields: [decidedById], references: [id])

  @@unique([userId, date, mealType])
  @@index([date, mealType, status])
}

model Visitor {
  id          String   @id @default(cuid())
  name        String
  phone       String?  @unique
  purpose     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  createdBy   User?               @relation("VisitorCreatedBy", fields: [createdById], references: [id])
  meals       VisitorMealChoice[]
}

model VisitorMealChoice {
  id             String   @id @default(cuid())
  visitorId      String
  date           String
  mealType       MealType
  wantMeal       Boolean
  createdById    String?
  overrideReason String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  visitor   Visitor @relation(fields: [visitorId], references: [id])
  createdBy User?   @relation("VisitorMealCreatedBy", fields: [createdById], references: [id])

  @@unique([visitorId, date, mealType])
  @@index([date, mealType])
}

model UserInvite {
  id                   String   @id @default(cuid())
  email                String   @unique
  role                 Role
  dept                 String?
  site                 String?
  supervisorEmployeeId String?
  tokenHash            String
  expiresAt            DateTime
  usedAt               DateTime?
  createdByUserId      String?
  createdAt            DateTime @default(now())

  createdBy            User?    @relation("UserInviteCreatedBy", fields: [createdByUserId], references: [id])

  @@index([expiresAt])
  @@index([usedAt])
  @@index([createdAt])
}
